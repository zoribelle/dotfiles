# Externally Managed Reference:
# https://www.chezmoi.io/reference/special-files/chezmoiexternal-format/

# Fonts
[".local/share/fonts/monocraft"]
    type = "file"
    url = "https://github.com/IdreesInc/Monocraft/releases/download/{{ (gitHubLatestRelease "IdreesInc/Monocraft").TagName }}/Monocraft.ttc"
    refreshPeriod = "168h"

[".local/share/fonts/libron"]
    type = "archive"
    url = "https://github.com/nicoverbruggen/libron/releases/download/{{ (gitHubLatestRelease "nicoverbruggen/libron").TagName }}/Libron_H.zip"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

