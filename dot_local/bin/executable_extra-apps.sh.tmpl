# Download RPMs
#   Applications goes in these associative arrays as Github ["User/Repo"]="version"
#   Some repos will fetch the latest stable instead of the newest builds

declare -A domain_repo=(
    ["TibixDev/winboat"]="{{ (gitHubLatestRelease "TibixDev/winboat").TagName }}"
    # ["TheAssassin/AppImageLauncher"]="{{ (gitHubLatestRelease "TheAssassin/AppImageLauncher").TagName }}"
    ["upscayl/upscayl"]="{{ (gitHubLatestRelease "upscayl/upscayl").TagName }}"
    ["rustdesk/rustdesk"]="{{ (gitHubLatestRelease "rustdesk/rustdesk").TagName }}"
    # ["mvdicarlo/postybirb"]="{{ (gitHubLatestRelease "mvdicarlo/postybirb").TagName }}"
    ["dnfui/dnf-ui"]="{{ (gitHubLatestRelease "dnfui/dnf-ui").TagName }}"
)

rpm_path="$HOME/Applications/Local-Repo"
for rpm_get in "${!domain_repo[@]}"; do
	echo "Downloading RPM from https://github.com/${rpm_get}/"

	gh release download \
	    --repo     "$rpm_get" \
	    --pattern  "*.rpm" \
	    --dir      "${rpm_path}/Packages/" \
	    --skip-existing \
	&& echo "Version ${domain_repo[${rpm_get}]} Completed" \
	|| echo "Failed to get $rpm_get" >&2;
done

# Signs packages and updates the repo database
echo -e "\nUpdating Zoe local repo."
# rpm --delsign "${rpm_path}"/Packages/*.rpm
rpm --addsign "${rpm_path}"/Packages/*.rpm
createrepo "${rpm_path}" && dnf clean all
exit 0
